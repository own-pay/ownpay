        <div class="ck-gw{% if gw.disabled is defined and gw.disabled %} ck-gw-disabled{% endif %}" data-action="pick-gw" data-tab="mfs" data-slug="{{ gw.slug }}" data-name="{{ gw.name }}" data-mode="{{ gw.mode ?? 'api' }}" data-color="{{ gw.color|default('#ECEEF5') }}" {% if gw.disabled is defined and gw.disabled %}data-disabled="1" data-reason="{{ gw.disabled_reason ?? 'Not available for this amount' }}" title="{{ gw.disabled_reason ?? 'Not available for this amount' }}"{% endif %}>
            {% if gw.mode == 'manual' %}<div class="ck-gw-badge">Manual</div>{% endif %}
            <div class="ck-gw-ico ck-gw-ico-{{ gw.slug }}">
                {% if gw.logo is defined and gw.logo %}
                    <img src="{{ gw.logo }}" alt="" class="ck-gw-logo">
                    <span class="ck-gw-fallback">{{ gw.name[:2] }}</span>
                {% else %}
                    <span class="ck-gw-fallback op-show-fallback">{{ gw.name[:2] }}</span>
                {% endif %}
            </div>
            <span class="ck-gw-name">{{ gw.name }}{% if gw.converted_amount is defined and gw.converted_amount %} ({{ gw.converted_amount }} {{ gw.converted_currency }}){% endif %}</span>
            {{ hook('checkout.gateway.extra', gw)|raw }}
        </div>
        {% endfor %}
        {% if gateways.mfs is empty %}
            <p class="ck-empty-gw">{{ lang.no_gateways ?? 'No MFS gateways configured.' }}</p>
        {% endif %}
    </div>
    <button type="button" id="mfsBtn" disabled class="ck-pay-btn ck-pay-disabled">{{ lang.select_provider ?? 'Select a provider' }}</button>
</div>

{# TAB: NET BANKING #}
<div id="t-bank" class="ck-tc {{ defaultTab != 'bank' ? 'ck-hidden' : '' }}">
    <div class="ck-gw-grid" id="bankG">
        {% for gw in gateways.bank %}
