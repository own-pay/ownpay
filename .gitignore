# =============================================================
# OwnPay .gitignore
# =============================================================

# --------------- Dependencies ---------------
/node_modules/

# --------------- Environment ---------------
.env
.envv
.env.local
.env.*.local

# Local PHP configuration must not be committed.
php.ini
php-*.ini
/public/.user.ini

# --------------- IDE / Editor ---------------
.vscode/
.idea/
*.swp
*.swo
*.zcode
*.zip

# --------------- OS ---------------
.DS_Store
Thumbs.db
desktop.ini

# --------------- PHP Tooling ---------------
/.phpunit.cache/
.twig-cs-fixer.cache
.php-cs-fixer.cache
.phpunit.result.cache
coverage/

# --------------- JS Tooling ---------------
.vitest/

# --------------- Agent / AI Tooling ---------------
.agents/
.claude/
.planning/
.remember/
.mimosa/
graphify-out/
task_plan.md
findings.md
progress.md
/output/
AGENTS.md
CLAUDE.md


# --------------- Non-Core Projects (separate repos) ---------------
/dev/

/cli/
/.docker/
/docs/images/
/docs/v2/
docker-compose.yml
Dockerfile



# --------------- Storage Runtime Artifacts ---------------
/storage/logs/*
/storage/sessions/*
/storage/cache/*
/storage/backups/*
/storage/languages/*
/storage/cron/*
/storage/framework/*
/storage/temp/*
/storage/pdf/*
/storage/update.lock
/storage/.installed
/public/assets/uploads/*

# Keep directory placeholders and access-control files in Git.
!/storage/logs/.gitkeep
!/storage/backups/.gitkeep
!/storage/languages/.gitkeep
!/storage/.htaccess
!/public/assets/uploads/.gitkeep

# Local server/tool configuration.
.dockerignore
*.log
*.pid
*.tmp

# --------------- Generated Reports ---------------
audit_report.md
phpstan_output.json
phpunit_output.txt

# --------------- Misc ---------------
*.pem
.phpunit.result.cache
install.sh
/update/
/.superpowers/
